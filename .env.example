# Скопируйте этот файл в .env и заполните значения: cp .env.example .env

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# PostgreSQL: при первом запуске контейнер db создаст пользователя и базу с этими данными.
# DB_HOST и DB_PORT задаются в docker-compose.yml, здесь их указывать не нужно.
DB_USERNAME=music_bot
DB_PASSWORD=
DB_NAME=music_bot
